(version 1)

# --- TRACK LIMITS ---
(rule "Track width, outer layer"
	(layer outer)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.127mm))
)

(rule "Track spacing, outer layer"
	(layer outer)
	(condition "A.Type == 'Track' && B.Type == A.Type")
	(constraint clearance (min 0.127mm))
)

(rule "Track width, inner layer"
	(layer inner)
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.09mm))
)

(rule "Track spacing, inner layer"
	(layer inner)
	(condition "A.Type == 'Track' && B.Type == A.Type")
	(constraint clearance (min 0.09mm))
)

# --- SILKSCREEN ---
(rule "Silkscreen text"
	(layer "*.SilkS")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1.0mm))
)

# --- BOARD EDGES ---
(rule "Edge (routed) to copper clearance"
	(constraint edge_clearance (min 0.3mm))
)

# --- HOLES & DRILLS ---
(rule "Hole diameter mechanical range"
	(constraint hole_size (min 0.2mm) (max 6.3mm))
)

(rule "NPTH hole diameter"
	(condition "!A.isPlated()")
	(constraint hole_size (min 0.5mm))
)

(rule "Hole (castellated) diameter"
	(condition "A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.6mm))
)

# --- ANNULAR RING ---
# 0.075mm allows JLCPCB's min via (0.35mm pad / 0.2mm drill)
(rule "Annular ring width"
	(layer outer)
	(condition "A.isPlated()")
	(constraint annular_width (min 0.075mm))
)

# --- HOLE-TO-HOLE CLEARANCE ---
(rule "Clearance: hole to hole, different nets"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm))
)

(rule "Clearance: hole to hole, same net"
	(condition "A.Net == B.Net")
	(constraint hole_to_hole (min 0.254mm))
)

# --- COPPER TO HOLE CLEARANCES ---
(rule "Clearance: track to NPTH hole"
	(condition "!A.isPlated() && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.254mm))
)

# FIX: Explicitly scoped to 'Pad' so Vias are NOT affected
(rule "Clearance: track to PTH pad hole"
	(condition "A.isPlated() && A.Type == 'Pad' && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.33mm))
)

# FIX: Vias only require 0.2mm hole-to-track clearance
(rule "Clearance: track to Via hole"
	(condition "A.Type == 'Via' && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.2mm))
)

# --- GENERAL COPPER CLEARANCE ---
# FIX: Reduced from 0.2mm to 0.127mm so fine-pitch SMD ICs route without errors
(rule "Clearance: pad to track"
	(condition "A.Type == 'Pad' && B.Type == 'Track' && A.Net != B.Net")
	(constraint clearance (min 0.127mm))
)
